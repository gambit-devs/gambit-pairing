{
  "_comment": "KDE Craft binary packages that provide the Breeze Qt6 widget style and its runtime libraries, generated from the Craft cache manifests; scripts/stage_breeze.py downloads exactly these files and verifies sha256. Targets with a 'rebuild' section build the listed frameworks from 'framework_sources' against the pinned official Qt SDK instead of using Craft's binaries; their 'build_packages' are Craft packages needed only to build them and are not shipped. license_dir names the directory below licenses/breeze/ with the full license texts that ship with each package.",
  "craft_release": "26.05",
  "base_url": "https://files.kde.org/craft/Qt6/26.05/{craft_path}/RelWithDebInfo/",
  "qt_sdks": {
    "_comment": "Official Qt SDK archives from download.qt.io (the same files the Qt online installer and aqtinstall use), pinned by SHA-256. Only used to build the frameworks in a target's 'rebuild' section. The PyQt6-Qt6 wheel version must match 'version'; on Windows the wheel's Qt6Core.dll is byte-identical to this SDK's.",
    "version": "6.11.2",
    "base_url": "https://download.qt.io/online/qtsdkrepository/",
