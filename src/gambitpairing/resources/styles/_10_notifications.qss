/* =============================================================================
   10 — NOTIFICATION WIDGET
   Toast-style overlays anchored to the main window.  The widget itself is
   transparent; the visual bubble is rendered by child QFrame/QWidget paint.

   Type variants
   -------------
   info    — neutral grey
   success — chess-green
   error   — red
   warning — amber (dark text for contrast)
   ============================================================================= */

/* Outer container — must be transparent so the window shows through */
QWidget#Notification {
  background: transparent;
}

/* Message text */
QLabel#NotificationMessage {
  font-size:   {{font_size_base}};
  font-weight: 600;
  background:  transparent;
  border:      none;
  color:       {{text_on_primary}};
}

/* Progress bar track */
QProgressBar#NotificationProgress {
  background-color: rgba(255, 255, 255, 0.08);
  border:           none;
  border-radius:    2px;
}

QProgressBar#NotificationProgress::chunk {
  border-radius: 2px;
}

/* --- Type: info (default) ------------------------------------------------- */
QWidget#Notification[type="info"] QLabel#NotificationMessage {
  color: {{text_on_primary}};
}
QWidget#Notification[type="info"] QProgressBar::chunk {
  background-color: {{text_secondary}};
}

/* --- Type: success -------------------------------------------------------- */
QWidget#Notification[type="success"] QLabel#NotificationMessage {
  color: {{text_on_primary}};
}
QWidget#Notification[type="success"] QProgressBar::chunk {
  background-color: {{color_primary_light}};
}

/* --- Type: error ---------------------------------------------------------- */
QWidget#Notification[type="error"] QLabel#NotificationMessage {
  color: {{text_on_primary}};
}
QWidget#Notification[type="error"] QProgressBar::chunk {
  background-color: {{state_error_accent}};
}

/* --- Type: warning -------------------------------------------------------- */
/* Warning uses dark text on amber for WCAG contrast. */
QWidget#Notification[type="warning"] QLabel#NotificationMessage {
  color: #111111;
}
QWidget#Notification[type="warning"] QProgressBar::chunk {
  background-color: {{state_warn_accent}};
}
