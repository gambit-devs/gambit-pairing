/* =============================================================================
   13 — DIALOGS
   Styles scoped to specific dialog classes.  Base QDialog appearance is
   defined in _08_chrome.qss; this file handles dialog-specific child widgets.
   ============================================================================= */

/* --- Manual-pairing dialog ------------------------------------------------ */
QDialog[class="ManualPairingDialog"] {
  background: {{bg_page}};
  color:      {{text_body}};
}

QLabel[class="ManualPairingDialog"] {
  color: {{text_body}};
}

QLineEdit[class="ManualPairingDialog"] {
  background:    {{bg_surface}};
  border:        1.5px solid {{border_input}};
  border-radius: {{radius_sm}};
  padding:       6px 10px;
  color:         {{text_body}};
  font-size:     {{font_size_sm}};
}

QLineEdit[class="ManualPairingDialog"]:focus {
  border-color: {{border_input_focus}};
  background:   {{bg_input_focus}};
}

QLineEdit[class="ManualPairingDialog"]:disabled {
  background:   {{bg_disabled}};
  color:        {{text_disabled}};
  border-color: {{border_medium}};
}

/* Dock widget inside manual-pairing dialog */
QDockWidget[class="ManualPairingDialog"] {
  background:    {{bg_surface}};
  border:        1px solid {{border_light}};
  border-radius: {{radius_md}};
}

QDockWidget[class="ManualPairingDialog"]::title {
  background:  {{bg_subtle}};
  color:       {{text_body}};
  font-weight: normal;
  font-size:   {{font_size_base}};
  padding:     4px;
  text-align:  left;
  border:      1px solid {{border_medium}};
  border-bottom: none;
}

QDockWidget[class="ManualPairingDialog"]::close-button,
QDockWidget[class="ManualPairingDialog"]::float-button {
  background:           transparent;
  border:               1px solid transparent;
  border-radius:        2px;
  subcontrol-position:  top right;
  subcontrol-origin:    margin;
  position:             relative;
  width:                14px;
  height:               14px;
}

QDockWidget[class="ManualPairingDialog"]::close-button:hover,
QDockWidget[class="ManualPairingDialog"]::float-button:hover {
  background: {{border_medium}};
  border:     1px solid {{text_muted}};
}

QDockWidget[class="ManualPairingDialog"]::close-button:pressed,
QDockWidget[class="ManualPairingDialog"]::float-button:pressed {
  background: {{border_header}};
}

/* --- Print-options dialog -------------------------------------------------- */
QDialog[class="PrintOptionsDialog"] {
  background: {{bg_page}};
}

/* --- Update download dialog ----------------------------------------------- */
QDialog[class="UpdateDownloadDialog"] {
  background: {{bg_page}};
}

QLabel[class="UpdateStatusLabel"] {
  font-size: 11pt;
  padding:   0 12px;
}

QProgressBar[class="UpdateProgressBar"] {
  min-height:    28px;
  font-size:     12pt;
  text-align:    center;
  border-radius: 14px;
}

QProgressBar[class="UpdateProgressBar"]::chunk {
  background-color: {{color_primary}};
  border-radius:    14px;
}

/* --- Update prompt dialog -------------------------------------------------- */
QDialog[class="UpdatePromptDialog"] {
  background: {{bg_page}};
}

QLabel[class="UpdatePromptTitle"] {
  color:       {{text_heading}};
  font-size:   14pt;
  font-weight: 700;
}

QLabel[class="UpdatePromptVersionInfo"] {
  font-size: 11pt;
}

QTextBrowser[class="ReleaseNotesText"] {
  background:    {{bg_surface}};
  border:        1px solid {{border_light}};
  border-radius: {{radius_sm}};
}

/* --- Pairing-system info dialog ------------------------------------------- */
QDialog[class="PairingInfoDialog"] {
  background: {{bg_page}};
}

QListWidget[class="PairingInfoToc"] {
  font-size: 11pt;
}

QLabel[class="PairingInfoTitle"] {
  color:         {{text_heading}};
  font-size:     15pt;
  font-weight:   700;
  margin-bottom: 6px;
}

QLabel[class="PairingInfoDescription"] {
  font-size:     11pt;
  margin-bottom: 8px;
}

QTextBrowser[class="PairingInfoDetails"] {
  background:    {{bg_surface}};
  border:        1px solid {{border_light}};
  border-radius: {{radius_sm}};
  font-size:     10.5pt;
}
