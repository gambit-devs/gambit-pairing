/* =============================================================================
   13 — DIALOGS
   Styles scoped to specific dialog classes.  Base QDialog appearance is
   defined in _08_chrome.qss; this file handles dialog-specific child widgets.
   ============================================================================= */

/* --- Manual-pairing dialog ------------------------------------------------ */
QDialog[class="ManualPairingDialog"] {
  background: {{bg_page}};
  color:      {{text_body}};
}

QMainWindow[class="ManualPairingMainWindow"] {
  background: {{bg_page}};
  border:     none;
}

QWidget[class="ManualPairingCentralWidget"],
QWidget[class="ManualPairingDockContents"] {
  background: {{bg_page}};
}

QWidget[class="ManualPairingToolbar"] {
  background: transparent;
}

QLabel[class="ManualPairingDialog"] {
  color: {{text_body}};
}

QLabel[class="ManualPairingInfoLabel"] {
  color:      {{text_muted}};
  font-style: italic;
  padding:    5px;
  font-size:  {{font_size_sm}};
}

QLabel[class="ManualPairingSearchLabel"] {
  color:       {{state_success_text}};
  font-weight: 600;
  font-size:   {{font_size_sm}};
}

QLabel[class="ManualPairingStatsLabel"] {
  color:         {{text_muted}};
  font-size:     {{font_size_sm}};
  padding:       5px;
  background:    {{bg_subtle}};
  border-radius: {{radius_sm}};
}

QLabel[class="ManualPairingByePlaceholder"] {
  color:            {{text_muted}};
  background:       {{bg_subtle}};
  border:           1px dashed {{border_medium}};
  border-radius:    {{radius_sm}};
  padding:          10px 6px;
  min-height:       42px;
}

QLabel[class="ManualPairingValidationLabel"] {
  padding:       10px;
  border-radius: 5px;
  font-weight:   700;
}

QLabel[class="ManualPairingValidationLabel"][state="warning"] {
  background-color: {{state_warn_bg}};
  color:            {{state_warn_text}};
  border:           1px solid {{state_warn_border}};
}

QLabel[class="ManualPairingValidationLabel"][state="success"] {
  background-color: {{state_success_bg}};
  color:            {{state_success_text}};
  border:           1px solid {{state_success_border}};
}

QLineEdit[class="ManualPairingDialog"] {
  background:    {{bg_surface}};
  border:        1.5px solid {{border_input}};
  border-radius: {{radius_sm}};
  padding:       6px 10px;
  color:         {{text_body}};
  font-size:     {{font_size_sm}};
}

QLineEdit[class="ManualPairingDialog"]:focus {
  border-color: {{border_input_focus}};
  background:   {{bg_input_focus}};
}

QLineEdit[class="ManualPairingDialog"]:disabled {
  background:   {{bg_disabled}};
  color:        {{text_disabled}};
  border-color: {{border_medium}};
}

/* Dock widget inside manual-pairing dialog */
QDockWidget[class="ManualPairingDialog"] {
  background:    {{bg_surface}};
  border:        1px solid {{border_light}};
  border-radius: {{radius_md}};
}

QDockWidget[class="ManualPairingDialog"]::title {
  background:  {{bg_subtle}};
  color:       {{text_body}};
  font-weight: normal;
  font-size:   {{font_size_base}};
  padding:     4px;
  text-align:  left;
  border:      1px solid {{border_medium}};
  border-bottom: none;
}

QListWidget[class="ManualPairingByeList"] {
  background-color: #fff3cd;
  border:           2px dashed #e2c290;
  border-radius:    {{radius_md}};
  padding:          4px;
}

QListWidget[class="ManualPairingByeList"]::item {
  padding:          6px 8px;
  margin:           1px;
  border-radius:    3px;
  background-color: #fff8e1;
  border:           1px solid #e2c290;
  color:            #8b5c2b;
  font-weight:      700;
}

QListWidget[class="ManualPairingByeList"]::item:hover {
  background-color: #ffecb3;
  border-color:     #d4ac0d;
}

QListWidget[class="ManualPairingByeList"]::item:selected {
  background-color: #d4ac0d;
  color:            white;
  border-color:     #b7950b;
}

/* --- Player-management dialog -------------------------------------------- */
QDialog[class="PlayerManagementDialog"] {
  background: {{bg_page}};
}

QPushButton[class="PlayerManagementCopyButton"] {
  background:    transparent;
  border:        none;
  border-radius: {{radius_sm}};
  padding:       0 4px;
}

QPushButton[class="PlayerManagementCopyButton"]:hover {
  background: {{table_hover_bg}};
}

QPushButton[class="PlayerManagementCopyButton"]:pressed {
  background: {{border_medium}};
}

QLabel[class="PlayerManagementInstructions"] {
  color:         {{text_body}};
  font-size:     {{font_size_xs}};
  background:    {{bg_subtle}};
  padding:       8px;
  border:        1px solid {{border_medium}};
  border-radius: {{radius_sm}};
  margin-bottom: 5px;
}

QLabel[class="PlayerManagementSearchStatus"] {
  color:      {{text_muted}};
  font-style: italic;
}

QLabel[class="PlayerManagementSearchStatus"][state="busy"] {
  color: {{color_primary}};
}

QLabel[class="PlayerManagementSearchStatus"][state="success"] {
  color:       {{state_success_text}};
  font-weight: 700;
}

QLabel[class="PlayerManagementSearchStatus"][state="warning"] {
  color:       {{state_warn_text}};
  font-weight: 700;
}

QLabel[class="PlayerManagementSearchStatus"][state="error"] {
  color:       {{state_error_accent}};
  font-weight: 700;
}

QLabel[class="PlayerManagementEmptyIcon"] {
  color:     {{text_muted}};
  font-size: 32pt;
  margin:    20px;
}

QLabel[class="PlayerManagementEmptyTitle"] {
  color:       {{text_muted}};
  font-size:   18pt;
  font-weight: 700;
  margin:      10px;
}

QLabel[class="PlayerManagementEmptySubtitle"] {
  color:         {{text_muted}};
  font-size:     12pt;
  margin-bottom: 20px;
}

QPushButton[class="PlayerManagementEmptyAction"] {
  padding:     12px 24px;
  font-size:   12pt;
  font-weight: 700;
}

/* --- Print-options dialog -------------------------------------------------- */
QDialog[class="PrintOptionsDialog"] {
  background: {{bg_page}};
}

/* --- Update download dialog ----------------------------------------------- */
QDialog[class="UpdateDownloadDialog"] {
  background: {{bg_page}};
}

/* --- Unsaved changes dialog ----------------------------------------------- */
QDialog[class="UnsavedChangesDialog"] {
  background: {{bg_page}};
}

QLabel[class="UnsavedChangesWarningIcon"] {
  background:    {{state_warn_accent}};
  color:         {{text_heading}};
  border-radius: 14px;
  font-size:     {{font_size_base}};
  font-weight:   700;
}

QLabel[class="UnsavedChangesMessage"] {
  color:     {{text_body}};
  font-size: {{font_size_base}};
}

QDialog[class="UnsavedChangesDialog"] QPushButton {
  padding:    4px 14px;
  min-height: 36px;
  max-height: 36px;
}

QLabel[class="UpdateStatusLabel"] {
  font-size: 11pt;
  padding:   0 12px;
}

QLabel[class="UpdateStatusLabel"][state="success"] {
  color: {{state_success_text}};
}

QLabel[class="UpdateStatusLabel"][state="error"] {
  color: {{state_error_accent}};
}

QProgressBar[class="UpdateProgressBar"] {
  min-height:    28px;
  font-size:     12pt;
  text-align:    center;
  border-radius: 14px;
}

QProgressBar[class="UpdateProgressBar"]::chunk {
  background-color: {{color_primary}};
  border-radius:    14px;
}

/* --- Update prompt dialog -------------------------------------------------- */
QDialog[class="UpdatePromptDialog"] {
  background: {{bg_page}};
}

QLabel[class="UpdatePromptTitle"] {
  color:       {{text_heading}};
  font-size:   14pt;
  font-weight: 700;
}

QLabel[class="UpdatePromptVersionInfo"] {
  font-size: 11pt;
}

QTextBrowser[class="ReleaseNotesText"] {
  background:    {{bg_surface}};
  border:        1px solid {{border_light}};
  border-radius: {{radius_sm}};
}

/* --- Pairing-system info dialog ------------------------------------------- */
QDialog[class="PairingInfoDialog"] {
  background: {{bg_page}};
}

QListWidget[class="PairingInfoToc"] {
  font-size: 11pt;
}

QLabel[class="PairingInfoTitle"] {
  color:         {{text_heading}};
  font-size:     15pt;
  font-weight:   700;
  margin-bottom: 6px;
}

QLabel[class="PairingInfoDescription"] {
  font-size:     11pt;
  margin-bottom: 8px;
}

QTextBrowser[class="PairingInfoDetails"] {
  background:    {{bg_surface}};
  border:        1px solid {{border_light}};
  border-radius: {{radius_sm}};
  font-size:     10.5pt;
}

/* --- About dialog ---------------------------------------------------------- */
QDialog[class="AboutDialog"] {
  background: {{bg_page}};
}

QTabWidget[class="AboutTabs"] QTabBar {
  qproperty-expanding: true;
}

QTabWidget[class="AboutTabs"] QTabBar::tab {
  min-width: 80px;
}

QLabel[class="AboutAppName"] {
  color:       {{text_heading}};
  font-size:   18px;
  font-weight: 700;
}

QLabel[class="AboutVersion"] {
  color:     {{text_muted}};
  font-size: 9px;
}

QLabel[class="AboutDescription"] {
  font-size: 10px;
}

QLabel[class="AboutSupport"] {
  font-size:  10px;
  margin-top: 10px;
}

QTextEdit[class="AboutLicenseText"] {
  border:        1px solid {{border_medium}};
  border-radius: {{radius_sm}};
  font-family:   monospace;
  font-size:     7px;
}
